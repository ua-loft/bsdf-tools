
% JPK
% 2026/08/11

% Debugging low TIS in Z307.

% =====================

clc, clearvars, close all



filepath_fred = "C:\Users\jakep\Documents\Optics_local\UofA\bsdf-tools\data\processed\fred\AeroglazeZ307_wPrimer9929__onAl6061T6_12x12in.txt";

[Pi, Ai, Ps, As, BRDF] = load_fred(filepath_fred);

mAi = Ai == 0; % (refers to specular ray; should all be 0 b/c isotropic)

mAiAs0 = and(mAi, As == 0); % (in-plane, specular side)
mAiAs180 = and(mAi, As == 180); % (in-plane, backscatter side)

figure
hold on
grid on
title('Corrected BRDF Data for Aeroglaze Z307 [Jacob K, 2026/08/11]')
ylabel('BRDF')
xlabel('Receive Angle [deg]')

colors = [ 68   1  84; ...
           49 104 142; ...
           53 183 121; ...
          253 231  37];

Pi_unique = unique(Pi);
for j = 1:length(Pi_unique)

    mPi = Pi == Pi_unique(j);

    mAiAs0Pi = and(mAiAs0, mPi);
    mAiAs180Pi = and(mAiAs180, mPi);

    receive = [-Ps(mAiAs180Pi), Ps(mAiAs0Pi)];
    BRDF = [BRDF(mAiAs180Pi), BRDF(mAiAs0Pi)];

    scatter(receive, BRDF, 'filled', 'Color', colors(j, :))

end

set(gca, 'YScale', 'log')
legend('Incidence 10°', 'Incidence 30°', 'Incidence 50°', 'Incidence 70°')


