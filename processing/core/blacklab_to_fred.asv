% 
% blacklab_to_fred.m
% 
% Description:
%   - Process raw measurement data from the Remote Sensing Group's (RSG) 
%     Blacklab scatterometer into FRED format, and save FRED file.
% 
% Assumptions:
%   1) 
% 
% Developer(s):
%   - Jacob P. Krell (JPK)
%       - LOFT research assistant
%       - MS Optomechanical Engineering, 
%         Wyant College of Optical Sciences, University of Arizona
%       - jacobpkrell@arizona.edu, jakepkrell@gmail.com
%
% Development History:
% | Date       | Dev. | Comment(s)                                        |
% |------------|------|---------------------------------------------------|
% | 2026.05.02 | JPK  | Initialized using 'rt300s_to_fred.m' as template; |
% 
% References:
% [1] 
% 
% =========================================================================
% =========================================================================
% =========================================================================
% =========================================================================

clearvars, clc, close all

% =========================================================================
% [BEGIN] USER INPUTS:

% Measured sample(s):
filepaths_blacklab = {'C:\Users\jakep\Documents\Optics_local\UofA\bsdf-tools\data\raw\blacklab\example\20250409_S7_swir_sample.txt'};
    % cell of filepath(s) to measured RT-300S data (include '.xls')
ISOTROPIC = true; % set true if sample is isotropic
ANISO_W_XZ_SYMM = false; % set true if sample is anisotropic but exhibits 
    % plane-symmetric features (e.g., lenslet array) across YZ plane when 
    % oriented at S=0 (zero stage rotation) and wanting to assume mirroring
    % of measured BRDF values
ANISO_W_YZ_SYMM = false; % same, but for XZ plane

% New FRED file's target filepath to save to (include '.txt'):
filepath_fred = 'C:\Users\jakep\Documents\Optics_local\UofA\bsdf-tools\data\processed\fred\test_blacklab_dev.txt';
OVERWRITE = true; % if true and FRED file already exists, will overwrite

% [END] USER INPUTS.
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% ================= The rest of this script is automated. =================
% =========================================================================
% =========================================================================
% [BEGIN] CONVERT BLACKLAB MEASUREMENT DATA TO BSDF FILE IN FRED FORMAT:

% Check if FRED file already exists:
if exist(filepath_fred, 'file')
    if OVERWRITE
        warning('FRED file already exists. It will be overwritten.')
    else
        error("FRED file already exists. Change target filename or set 'OVERWRITE' to true.")
    end
end

% Check user input logic:
if ISOTROPIC
    if or(ANISO_W_XZ_SYMM, ANISO_W_YZ_SYMM)
        warning("Setting 'ANISO_W_XZ_SYMM' and 'ANISO_W_YZ_SYMM' to false because 'ISOTROPIC' is true.")
        ANISO_W_XZ_SYMM = false;
        ANISO_W_YZ_SYMM = false;
    end
end

% Load Blacklab data and process into FRED coordinates:
[lambda, src_z, src_a, view_z, view_a, BRDF] = process_blacklab(filepaths_blacklab);
[Pi, Ai, Ps, As] = blacklab_frame_to_fred(src_z, src_a, view_z, view_a);

% If the sample is anisotropic, but exhibits plane symmetry about the XZ 
% and/or YZ planes (as defined by FRED coordinates), then can apply the 
% following to get a full azimuthal dataset for FRED:

% Apply YZ symmetry first so later XZ symmetry may drive \phi_i \in [0, 90]
% measurements to full \phi_i \in [0, 360) FRED equivalent:
if ANISO_W_YZ_SYMM
    [Pi, Ai, Ps, As, BRDF, lambda] = apply_yz_symm_to_fred(Pi, Ai, Ps, As, BRDF, lambda);
end

% Apply XZ symmetry:
if ANISO_W_XZ_SYMM
    [Pi, Ai, Ps, As, BRDF, lambda] = apply_xz_symm_to_fred(lambda, Pi, Ai, Ps, As, BRDF, lambda);
end

% Remove FRED redundancy (at Ps=0 only need one As angle, and average-out 
% any duplicated angles):
[Pi, Ai, Ps, As, BRDF, lambda] = remove_fred_redundancy(Pi, Ai, Ps, As, BRDF, lambda);

% Remove FRED redundancy for isotropic data (only need one Ai angle, and 
% only need $As - Ai \in [0, 180]$ defined):
if ISOTROPIC
    [Pi, Ai, Ps, As, BRDF, lambda] = remove_fred_redundancy_iso(Pi, Ai, Ps, As, BRDF, lambda);
end

% Write to FRED file (one file per wavelength):
for lambda_j = unique(lambda)
    m = lambda == lambda_j;
    % write_fred(lambda, Pi, Ai, Ps, As, BRDF, filepath_fred);
    lambda_j_str = num2str(lambda_j);
    lambda_j_str = strrep(lambda_j_str, '.', 'o'); %
    filepath_fred_j = filepath_fred(1 : end-4) + "_NNnm.txt";
    write_fred(Pi(m), Ai(m), Ps(m), As(m), BRDF(m), filepath_fred_j);
end

% [END] CONVERT RAW RT-300S MEASUREMENT DATA TO BSDF FILE IN FRED FORMAT.
% =========================================================================
% =========================================================================

